{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MediCare HMS",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MEDICARE HOSPITAL MANGAMENT/MEDICARE HOSPITAL MANGAMENT.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MEDICARE HOSPITAL MANGAMENT/MEDICARE HOSPITAL MANGAMENT.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
